---
/**
 * One room type: photo, name, how many it sleeps, a short description, the
 * indicative rate, and a WhatsApp link with the room already in the message.
 */
import Photo from './primitives/Photo.astro';
import Placeholder from './primitives/Placeholder.astro';
import WhatsAppLink from './WhatsAppLink.astro';

interface Props {
	title: string;
	sleeps: number;
	summary: string;
	rate: string;
	rateNote?: string;
	features?: string[];
	image: string;
	imageAlt: string;
}

const { title, sleeps, summary, rate, rateNote, features = [], image, imageAlt } = Astro.props;
---

<article class="room">
	<div class="room__media">
		<Photo
			src={image}
			alt={imageAlt}
			sizes="(min-width: 1200px) 30vw, (min-width: 768px) 46vw, 92vw"
		/>
	</div>

	<div class="room__body">
		<header class="room__head">
			<h3 class="room__title">{title}</h3>
			<p class="room__sleeps">
				Sleeps <span class="figure">{sleeps}</span>
			</p>
		</header>

		<p class="room__summary">{summary}</p>

		{features.length > 0 && (
			<ul class="room__features">
				{features.map((feature) => (
					<li>{feature}</li>
				))}
			</ul>
		)}

		<p class="room__rate">
			<Placeholder value={rate} figure />
			{rateNote && (
				<span class="room__rate-note">
					<Placeholder value={rateNote} />
				</span>
			)}
		</p>

		<div class="room__cta">
			<WhatsAppLink context={`the ${title}`} label="Ask about this room" />
		</div>
	</div>
</article>

<style>
	.room {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background-color: var(--bg-raised);
		border-radius: var(--radius-lg);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 8%, transparent);
	}

	.room__media :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.room__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-xs);
		padding: var(--space-md);
	}

	.room__head {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs) var(--space-sm);
		align-items: baseline;
		justify-content: space-between;
	}

	.room__sleeps {
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	.room__features {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-sm);
	}

	.room__features li {
		padding: 0.2em 0.7em;
		border: 1px solid var(--rule);
		border-radius: 999px;
		color: var(--fg-muted);
	}

	.room__rate {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		align-items: baseline;
		/* Pushes rate and button to the bottom so cards in a row line up. */
		margin-block-start: auto;
		padding-block-start: var(--space-xs);
		font-size: var(--text-lg);
	}

	.room__rate-note {
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	.room__cta :global(a) {
		width: 100%;
	}
</style>
