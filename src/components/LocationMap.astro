---
/**
 * The Google map, loaded only when a visitor asks for it.
 *
 * A Google Maps iframe pulls in several hundred KB of Google's JavaScript and
 * sets Google cookies. Loading it up front would cost the page its speed on
 * mobile data and its "cookieless, so no consent banner" footing. So the page
 * ships a placeholder, and the iframe is created on tap.
 *
 * Without JavaScript the button stays hidden and the panel is just a link to
 * Google Maps, which is the same destination.
 */
import { CONTACT, SITE } from '../config/site';
---

<div class="map" data-map-src={CONTACT.mapsEmbedUrl}>
	<div class="map__frame">
		<div class="map__facade">
			<button class="map__load" type="button" hidden>
				Show the map here
			</button>
			<a class="map__open" href={CONTACT.mapsUrl} rel="noopener" target="_blank">
				Open in Google Maps
				<span class="visually-hidden">(opens in a new tab)</span>
			</a>
			<p class="map__note" hidden>
				Showing the map here loads it from Google.
			</p>
		</div>
	</div>
	<p class="map__caption">
		{SITE.place.island}, {SITE.place.province}
	</p>
</div>

<script>
	const title = 'Map showing the location of the inn on Bantayan Island';

	for (const map of document.querySelectorAll<HTMLElement>('.map[data-map-src]')) {
		const button = map.querySelector<HTMLButtonElement>('.map__load');
		const note = map.querySelector<HTMLElement>('.map__note');
		const frame = map.querySelector<HTMLElement>('.map__frame');
		if (!button || !frame) continue;

		button.hidden = false;
		if (note) note.hidden = false;

		button.addEventListener('click', () => {
			const iframe = document.createElement('iframe');
			iframe.src = map.dataset.mapSrc ?? '';
			iframe.title = title;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';
			iframe.allowFullscreen = true;
			frame.replaceChildren(iframe);
			iframe.focus();
		});
	}
</script>

<style>
	.map__frame {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background-color: var(--bg-raised);
		/* A faint grid, so the empty panel reads as "map" before it loads. */
		background-image:
			linear-gradient(var(--rule) 1px, transparent 1px),
			linear-gradient(90deg, var(--rule) 1px, transparent 1px);
		background-size: 32px 32px;
	}

	.map__frame :global(iframe) {
		width: 100%;
		height: 100%;
		border: 0;
	}

	.map__facade {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		align-items: center;
		justify-content: center;
		height: 100%;
		padding: var(--space-md);
		text-align: center;
	}

	.map__load {
		min-height: 44px;
		padding: 0.7em 1.3em;
		border: 2px solid transparent;
		border-radius: var(--radius-md);
		background-color: var(--cta-bg);
		color: var(--cta-fg);
		font-weight: var(--weight-semibold);
		cursor: pointer;
		transition: background-color var(--duration-base) var(--ease-out);
	}

	.map__load:hover {
		background-color: var(--cta-bg-hover);
	}

	.map__open {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: var(--weight-semibold);
	}

	.map__note,
	.map__caption {
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	.map__caption {
		margin-block-start: var(--space-2xs);
	}

	/* `hidden` must win over the flex/inline-flex display rules above. */
	.map [hidden] {
		display: none;
	}
</style>
