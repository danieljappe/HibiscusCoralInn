---
/**
 * The end of the page. WhatsApp first, then phone and email, then the map.
 */
import { requirePage } from '../../lib/content';
import SectionHead from '../SectionHead.astro';
import ContactMethods from '../ContactMethods.astro';
import LocationMap from '../LocationMap.astro';

const entry = await requirePage('contact');
const { title, intro } = entry.data;
---

<section class="section contact" id="contact" data-tone="plum" aria-labelledby="contact-heading">
	<div class="container contact__inner">
		<div class="contact__text">
			<SectionHead id="contact-heading" title={title} intro={intro} />
			<ContactMethods label="Message us on WhatsApp" />
		</div>

		<LocationMap />
	</div>
</section>

<style>
	.contact__inner {
		display: grid;
		gap: var(--space-xl);
	}

	.contact__text {
		display: grid;
		gap: var(--space-lg);
		align-content: start;
	}

	@media (min-width: 768px) {
		.contact__inner {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
	}
</style>
