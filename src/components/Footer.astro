---
/**
 * Continues the dark plum of the contact section above it, so the page ends
 * on one dark band rather than snapping back to light.
 */
import Placeholder from './primitives/Placeholder.astro';
import { SITE, CONTACT } from '../config/site';
import { isPlaceholder } from '../lib/placeholders';

const year = new Date().getFullYear();

const socials = [
	{ label: 'Facebook', url: CONTACT.facebook },
	{ label: 'Instagram', url: CONTACT.instagram },
];
---

<footer class="site-footer" data-tone="plum">
	<div class="container site-footer__inner">
		<p class="site-footer__name">{SITE.name}</p>

		<p class="site-footer__place">
			{isPlaceholder(CONTACT.address) ? <Placeholder value={CONTACT.address} /> : CONTACT.address}
			<br />
			{SITE.place.island}, {SITE.place.province}, {SITE.place.country}
		</p>

		<ul class="site-footer__socials">
			{socials.map((social) => (
				<li>
					{isPlaceholder(social.url) ? (
						<>
							<span>{social.label}</span> <Placeholder value={social.url} />
						</>
					) : (
						<a href={social.url} rel="me noopener" target="_blank">
							{social.label}
						</a>
					)}
				</li>
			))}
		</ul>

		<p class="site-footer__legal">
			&copy; {year} {SITE.name}
		</p>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: var(--space-lg) var(--space-xl);
		border-block-start: 1px solid var(--rule);
	}

	.site-footer__inner {
		display: grid;
		gap: var(--space-sm);
		font-size: var(--text-sm);
		color: var(--fg-muted);
	}

	.site-footer__name {
		font-family: var(--font-display);
		font-variation-settings: 'SOFT' 100;
		font-size: var(--text-lg);
		color: var(--fg);
	}

	.site-footer__socials {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs) var(--space-md);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__socials a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-weight: var(--weight-semibold);
	}

	@media (min-width: 768px) {
		.site-footer__inner {
			grid-template-columns: 1fr 1fr auto;
			align-items: start;
		}

		.site-footer__legal {
			grid-column: 1 / -1;
		}
	}
</style>
